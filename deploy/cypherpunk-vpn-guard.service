[Unit]
Description=cypherpunk_vpn early whole-device privacy guard
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service systemd-networkd.service cypherpunk-vpn.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/cypherpunk-vpn-bootguard
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
# The guard only reads the saved profile and loads the kill switch into the host's
# nftables: it creates no namespace and writes no file, so it runs fully sandboxed.
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
KeyringMode=private
LimitCORE=0
StandardOutput=null
StandardError=null
# No logs at all: also suppresses the service manager's own messages about this unit.
LogLevelMax=emerg

[Install]
WantedBy=multi-user.target
