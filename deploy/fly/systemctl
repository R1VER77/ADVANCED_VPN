#!/bin/sh
# A systemctl for the cloud scripts on a Fly.io Machine (deploy/fly/init.sh is the service
# manager). Only cypherpunk-vpn.service exists; every other unit is inactive.
quiet=; verb=
for a in "$@"; do
  case "$a" in
    -q|--quiet) quiet=1 ;;
    -*) ;;
    *) if [ -z "$verb" ]; then verb=$a; else unit=$a; fi ;;
  esac
done
running() { [ -f /run/cpvpn-supervisor.pid ] && kill -0 "$(cat /run/cpvpn-supervisor.pid)" 2>/dev/null; }
case "$unit" in cypherpunk-vpn|cypherpunk-vpn.service) ;; *) [ "$verb" = is-active ] && { [ -n "$quiet" ] || echo inactive; exit 3; }; exit 0 ;; esac
case "$verb" in
  is-active) if running; then [ -n "$quiet" ] || echo active; exit 0; fi
             if [ -e /run/cpvpn-stopped ]; then s=inactive; else s=activating; fi; [ -n "$quiet" ] || echo $s; exit 3 ;;
  stop) touch /run/cpvpn-stopped; running && kill "$(cat /run/cpvpn-supervisor.pid)"; i=0
        while running && [ $i -lt 20 ]; do sleep 0.5; i=$((i+1)); done; exit 0 ;;
  start) rm -f /run/cpvpn-stopped; exit 0 ;;
  restart) rm -f /run/cpvpn-stopped; running && kill "$(cat /run/cpvpn-supervisor.pid)"; i=0
           while ! running && [ $i -lt 30 ]; do sleep 0.5; i=$((i+1)); done; exit 0 ;;
  *) exit 0 ;;  # enable, disable, reset-failed, daemon-reload: nothing to do here
esac
