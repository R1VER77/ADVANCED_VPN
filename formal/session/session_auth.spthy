// session_auth.spthy - Tamarin model of hardware-bound sessions
// (docs/HARDWARE_BOUND_SESSIONS.md, phases 1 and 2). Companion to tools/session_auth.py,
// tools/session_signer.py, src/session_auth.rs and src/tls.rs (`authenticated`,
// `issued_by_pinned`).
//
// MODELED: a client has a long-term identity key (ML-DSA-65), used only by a short-lived
// signer, and a FIDO2 key whose private key never leaves the device; a hop pins both at
// enrollment. For each session window the client makes a fresh session key; after a touch
// the device signs a statement naming that session key and the window, and the signer
// certifies the session key under the identity for that window. The data plane holds only
// the session key, which signs the TLS handshake. The hop accepts a handshake only if the
// session key signed its fresh challenge, the pinned identity certified that key for the
// hop's current window, and the pinned device signed a statement naming that key and window.
// Compromise: the data plane's memory (leak_session: one session key), the signer's moment
// (leak_identity: the long-term identity), the device itself (leak_device).
// ABSTRACTED: the 12 h window and the clock as fresh window names; the leaf, its extension
// and the WebAuthn byte layout as one certificate and one statement; TLS as a signature over
// the hop's nonce. ES256/EdDSA and ML-DSA-65 are the signing builtin.
//
// LEMMAS:
//  0. executable                  an honest session is accepted.
//  1. device_authorized           every accepted session was touched on the device for that
//                                 session key and window, unless the device key leaked.
//  2. stolen_identity_needs_touch with the identity copied, a session in a window still needs
//                                 a touch in that window (or the device key).
//  3. identity_still_required     every accepted session key was certified by the signer for
//                                 its window, unless the identity leaked (the PQ half alone).
//  4. stolen_session_key_expires  a session key taken from the data plane is accepted only in
//                                 the window it was made for, unless both long-term keys leaked.
//  5. both_halves                 a session nobody honest started needs both long-term keys.
theory session_auth
begin

builtins: signing

restriction equality:
  "All x y #i. Eq(x, y) @i ==> x = y"

rule client:
  [ Fr(~ik), Fr(~dk) ]
  --[ Client(pk(~ik), pk(~dk)) ]->
  [ !Identity(~ik, pk(~dk)), !Device(~dk, pk(~ik)), !Pinned(pk(~ik), pk(~dk)), Out(<pk(~ik), pk(~dk)>) ]

rule leak_identity:
  [ !Identity(ik, dpk) ]
  --[ IdentityLeaked(pk(ik)) ]->
  [ Out(ik) ]

rule leak_device:
  [ !Device(dk, ipk) ]
  --[ DeviceLeaked(pk(dk)) ]->
  [ Out(dk) ]

// The hop's clock opens a new window; it is public.
rule window:
  [ Fr(~w) ]
  --[ WindowOpened(~w) ]->
  [ !Window(~w), Out(~w) ]

// A session: a fresh key, a touch on the device naming it, the signer's certificate.
rule session:
  [ !Identity(ik, pk(dk)), !Device(dk, pk(ik)), !Window(w), Fr(~sk) ]
  --[ SessionKeyFor(pk(~sk), w), Touched(pk(ik), pk(dk), pk(~sk), w), Certified(pk(ik), pk(~sk), w) ]->
  [ !Session(~sk, pk(ik), w),
    Out(<sign(<'session', pk(~sk), w>, dk), sign(<'cert', pk(~sk), w>, ik)>) ]

// The data plane's memory: one session key.
rule leak_session:
  [ !Session(sk, ipk, w) ]
  --[ SessionLeaked(pk(sk), w) ]->
  [ Out(sk) ]

rule client_handshake:
  [ !Session(sk, ipk, w), In(n) ]
  --[ SessionSigned(pk(sk), n) ]->
  [ Out(<pk(sk), sign(<'tls', n>, sk)>) ]

rule hop_challenge:
  [ !Pinned(ipk, dpk), !Window(w), Fr(~n) ]
  --[ Challenge(~n) ]->
  [ Waiting(ipk, dpk, w, ~n), Out(~n) ]

rule hop_accept:
  [ Waiting(ipk, dpk, w, n), In(<spk, tls, cert, statement>) ]
  --[ Eq(verify(tls, <'tls', n>, spk), true),
      Eq(verify(cert, <'cert', spk, w>, ipk), true),
      Eq(verify(statement, <'session', spk, w>, dpk), true),
      Accepted(ipk, dpk, spk, w, n) ]->
  []

lemma executable:
  exists-trace
  "Ex ipk dpk spk w n #i. Accepted(ipk, dpk, spk, w, n) @i
     & not (Ex #l. IdentityLeaked(ipk) @l) & not (Ex #l. DeviceLeaked(dpk) @l)"

lemma device_authorized:
  "All ipk dpk spk w n #i. Accepted(ipk, dpk, spk, w, n) @i ==>
     (Ex #t. Touched(ipk, dpk, spk, w) @t & #t < #i) | (Ex #l. DeviceLeaked(dpk) @l)"

lemma stolen_identity_needs_touch:
  "All ipk dpk spk w n #i #l. Accepted(ipk, dpk, spk, w, n) @i & IdentityLeaked(ipk) @l ==>
     (Ex #t. Touched(ipk, dpk, spk, w) @t) | (Ex #d. DeviceLeaked(dpk) @d)"

lemma identity_still_required:
  "All ipk dpk spk w n #i. Accepted(ipk, dpk, spk, w, n) @i ==>
     (Ex #c. Certified(ipk, spk, w) @c & #c < #i) | (Ex #l. IdentityLeaked(ipk) @l)"

lemma stolen_session_key_expires:
  "All ipk dpk spk w w0 n #i #s #l. Accepted(ipk, dpk, spk, w, n) @i & SessionKeyFor(spk, w0) @s
     & SessionLeaked(spk, w0) @l ==>
     w = w0 | ((Ex #a. IdentityLeaked(ipk) @a) & (Ex #b. DeviceLeaked(dpk) @b))"

lemma both_halves:
  "All ipk dpk spk w n #i. Accepted(ipk, dpk, spk, w, n) @i
     & not (Ex #t. Touched(ipk, dpk, spk, w) @t) & not (Ex #c. Certified(ipk, spk, w) @c) ==>
     (Ex #a. IdentityLeaked(ipk) @a) & (Ex #b. DeviceLeaked(dpk) @b)"

end
