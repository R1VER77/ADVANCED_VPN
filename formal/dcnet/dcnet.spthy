// dcnet.spthy — Tamarin model of the DC-net control channel round core (trace properties).
// Companion to docs/DCNET_CONTROL_DESIGN.md §2–§4 and §6 (VERIFICATION_PLAN items 8–9).
// Sender anonymity is an equivalence property and lives in dcnet_anonymity.spthy.
//
// MODELED (a 3-member cell, the smallest non-trivial one):
//  - enrollment: one fresh pairwise key per member pair, and an anonymous cell MAC key
//    (the design's blinded per-epoch key: it proves membership, never which member);
//  - rounds: fresh, public, never reused (§1.2);
//  - transmit: each member sends exactly one frame per round (restriction), the XOR of
//    the pads it shares, plus its event if it is the sender (§2);
//    pad_ij(r) = h(<K_ij, r>) (the PRG/HKDF chain, symbolically one-way);
//  - frames travel over the adversary-controlled network as <r, body, mac> with
//    mac = h(<'dc-mac', Kcell, r, body>) (§3);
//  - aggregation: any party with the cell key accepts three distinct, authenticated
//    frames of round r and XORs them (§4).
//
// LEMMAS (proved with Tamarin 1.12.0 / Maude 3.5.1; CI runs them, docs/evidence/TAMARIN.json):
//  0. keys_secret          the pairwise and cell keys never leave the members.
//  1. frame_authenticity   accepted frames were transmitted in that very round (proved
//                          and mutation-checked in dcnet_authenticity.spthy).
//  2. cancellation         a round decodes to zero (nobody sent), to the one sender's
//                          event, or (collision) at least two members sent (§4 policy).
//
// Not proved here, and why:
//  - per-round pad secrecy and an existence ("executable") trace: with frames of
//    unboundedly many rounds and XOR inside the MAC, Tamarin does not terminate (tried:
//    default, s, S, C, i heuristics, DFS/BFS trace search, bound 12; up to 20 minutes).
//    A round's decoding and what a colluding member learns are proved in
//    dcnet_collusion.spthy instead.
//  - sender anonymity: it is an equivalence property ("A sent" vs "B sent" look the same).
//    Tamarin's --diff mode with XOR did not terminate even on the two-party core
//    (m^p, p, m) vs (p, m^p, m); the argument stays the standard one-time-pad argument
//    (docs/DCNET_CONTROL_DESIGN.md §2), not a machine-checked proof.
//
// NOT MODELED (documented limits): member churn and epoch re-keying; jamming (§5 accepts
// DoS); byte-level framing (CRC, flags constant).

// Pads: h(<k, r>) stands for the pair's one-time pad for round r (a hardware random
// value, one per pair and round; src/dcnet.rs PadBook). In this model it behaves the same:
// secret, distinct per round, known only to the pair. See dcnet_one_time_pads.spthy.

theory dcnet_round
begin

builtins: hashing, xor

// ---------------------------------------------------------------------------
// Enrollment: fresh pairwise keys and the anonymous cell MAC key, stored per member.
// ---------------------------------------------------------------------------
rule enroll:
  [ Fr(~kab), Fr(~kac), Fr(~kbc), Fr(~kcell) ]
  --[ PairKey(~kab), PairKey(~kac), PairKey(~kbc), CellKey(~kcell), Enrolled() ]->
  [ !Member('A', ~kab, ~kac, ~kcell),
    !Member('B', ~kab, ~kbc, ~kcell),
    !Member('C', ~kac, ~kbc, ~kcell),
    !Cell(~kcell) ]

// Round activation: a fresh public round id.
rule round_begin:
  [ Fr(~r) ]
  --[ RoundStart(~r) ]->
  [ !Round(~r), Out(~r) ]

// A member transmits silently: the XOR of its two pads.
rule transmit_silent:
  [ !Member(id, k1, k2, kc), !Round(r) ]
  --[ Transmit(id, r, h(<k1, r>) XOR h(<k2, r>)) ]->
  [ Out(<r, h(<k1, r>) XOR h(<k2, r>), h(<'dc-mac', kc, r, h(<k1, r>) XOR h(<k2, r>)>)>) ]

// A member transmits an event ~m.
rule transmit_send:
  [ !Member(id, k1, k2, kc), !Round(r), Fr(~m) ]
  --[ Transmit(id, r, ~m XOR h(<k1, r>) XOR h(<k2, r>)), Sent(id, r, ~m) ]->
  [ Out(<r, ~m XOR h(<k1, r>) XOR h(<k2, r>), h(<'dc-mac', kc, r, ~m XOR h(<k1, r>) XOR h(<k2, r>)>)>) ]

// Exactly one frame per member per round (§1.2: every online member sends one).
restriction one_frame_per_member_per_round:
  "All id r f g #i #j. Transmit(id, r, f) @i & Transmit(id, r, g) @j ==> #i = #j"

// Aggregation by any holder of the cell key: three distinct authenticated frames of
// round r are XORed. (Identical frames are rejected: a replayed copy is not a member.)
rule aggregate:
  [ !Cell(kc), !Round(r),
    In(<r, f1, h(<'dc-mac', kc, r, f1>)>),
    In(<r, f2, h(<'dc-mac', kc, r, f2>)>),
    In(<r, f3, h(<'dc-mac', kc, r, f3>)>) ]
  --[ Accept(r, f1), Accept(r, f2), Accept(r, f3),
      Distinct(f1, f2), Distinct(f1, f3), Distinct(f2, f3),
      Decoded(r, f1 XOR f2 XOR f3) ]->
  []

restriction distinct:
  "All x y #i. Distinct(x, y) @i ==> not (x = y)"

// ---------------------------------------------------------------------------
// Lemmas
// ---------------------------------------------------------------------------

// 0. Helper: the pairwise and cell keys never leave the members.
lemma keys_secret [reuse]:
  "(All k #i #j. PairKey(k) @i & K(k) @j ==> F) & (All k #i #j. CellKey(k) @i & K(k) @j ==> F)"

// 1. Accepted frames were transmitted in that round by a member (no fabrication, no
//    replay into another round: the MAC binds the round).
lemma frame_authenticity:
  "All r f #i. Accept(r, f) @i ==> Ex id #j. Transmit(id, r, f) @j & #j < #i"

// 2. Completeness of decoding, with the design's collision outcome.
lemma cancellation:
  "All r x #i. Decoded(r, x) @i ==>
     x = zero
     | (Ex id #j. Sent(id, r, x) @j)
     | (Ex id1 id2 m1 m2 #j #l. Sent(id1, r, m1) @j & Sent(id2, r, m2) @l & not (id1 = id2))"

end
