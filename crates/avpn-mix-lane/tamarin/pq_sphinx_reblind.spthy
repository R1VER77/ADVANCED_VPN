theory pq_sphinx_reblind
begin

// ---------------------------------------------------------------------------
// PQ-Sphinx option E, §2.3 XOR re-blinding — Tamarin SKELETON.
//
// STATUS: NOT YET VERIFYING. This file pins the rules and lemma statements
// from REBLINDING_PLAN.md so the verification effort starts from a fixed
// target. TODOs mark where restriction lemmas / source labels are expected
// to be needed (Tamarin 1.10+, XOR theory enabled).
//
// Scope note: we model ONLY the re-blinding of hop 2's element. The R1
// shift streams, MACs, and payload masks are abstracted away — they are
// standard-primitive composition and are covered by the test suite, not by
// this model. The 4-byte fixed prefix is public by design.
// ---------------------------------------------------------------------------

builtins: xor, hashing, symmetric-encryption

// --- Facts -----------------------------------------------------------------

// Entry-hop PQ secret recovered from ML-KEM (abstract: adversary cannot
// learn k1 without breaking the KEM).
symbol EntrySecret: lemma-fact [no-decon]
// Hop-2 element as generated by the client (fresh uniform).
symbol Elem2Fresh: fact
// Pad derived from k1 via HKDF (modeled as a hash of the secret).
symbol Pad2: fact
// The blinded element as it appears on the entry link.
symbol BlindedElem2: fact
// The element as seen by hop 2 after hop 1 peels.
element PeeledElem2: fact
// Adversary observation of a link.
symbol Observed: fact

// --- Rules ------------------------------------------------------------------

// The client derives the pad from the entry secret and blinds the element.
// TODO: k1 must be marked adversary-unknowable (source lemma on KEMdec).
rule ClientBlind:
  [ EntrySecret(k1)
  , Elem2Fresh(e2)
  ]
  --[ PadDerives(k1, h(k1, 'pad2')) ]->
  [ Pad2(h(k1, 'pad2'))
  , BlindedElem2(xor(e2, h(k1, 'pad2')))
  ]

// Hop 1 peels: removes the pad. The mix never emits k1.
rule EntryPeel:
  [ EntrySecret(k1)
  , BlindedElem2(b)
  ]
  --[ Peeled(xor(b, h(k1, 'pad2'))) ]->
  [ PeeledElem2(xor(b, h(k1, 'pad2'))) ]

// Adversary observes a link and may XOR-tag traffic in transit.
// TODO: restrict tagging to BEFORE the peel so the tag dies with the MAC.
rule ObserveAndTag:
  [ BlindedElem2(b) ]
  --[ Observed(b, xor(b, t)) ]->
  [ BlindedElem2(xor(b, t)) ]

// --- Lemmas -----------------------------------------------------------------

// (1) Pad secrecy: the pad is a function of k1 only; without k1 it is
//     indistinguishable from fresh.
//     TODO: needs a source lemma tying h(k1,'pad2') to the KEM secret;
//     expected to require restricting EntrySecret to honest-session origin.
lemma pad_secret:
  " ∀ p #i. Pad2(p) #i
    ==> ∃ k1 #j. EntrySecret(k1) #j & p = h(k1, 'pad2')
      & ( ∀ x #t. KEMbreak(k1) @ t ==> FALSE )"

// (2) Unlinkability across hop 1: any two peeled elements are
//     indistinguishable from fresh; the adversary cannot connect the
//     blinded value it observed to the peeled value.
//     TODO: bisimulation-style statement; Tamarin needs the observation
//     ordering made explicit (Observed before Peeled).
lemma no_linkability:
  " ∀ e f #i #j. PeeledElem2(e) #i & PeeledElem2(f) #j & i < j
    ==> ∃ r s. Fresh(r) & Fresh(s)
      & Not( ∃ b t. Observed(b, t) #t & Links(b, e) )"

// (3) Tagging containment: a tagged blinded element either fails the hop-2
//     MAC (modeled as: never yields a Peeled fact the adversary can trace)
//     or is equivalent to an untagged one.
//     TODO: this is where the malleability hand-analysis (REBLINDING_PLAN
//     item 2) gets its formal shadow; expect to weaken to a trace property.
lemma tagging_fails_closed:
  " ∀ b t #i. Observed(b, t) #i
    ==> ( ∃ e #j. PeeledElem2(e) #j & Links(t, e) ) | TagDied(t) #i"

end
