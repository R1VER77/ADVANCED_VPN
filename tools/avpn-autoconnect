#!/bin/sh
# NetworkManager dispatcher hook: auto-connect on untrusted networks.
#
# Install (the package does this, or by hand):
#   install -m 0755 avpn-autoconnect /etc/NetworkManager/dispatcher.d/avpn-autoconnect
#   install -d -m 0755 /etc/NetworkManager/dispatcher.d/pre-up.d
#   ln -sf ../avpn-autoconnect /etc/NetworkManager/dispatcher.d/pre-up.d/avpn-autoconnect
#
# Opt in (off by default; 0600, root-owned):
#   install -m 0600 -o root -g root /dev/null /etc/advanced-vpn/autoconnect.json
#   cat > /etc/advanced-vpn/autoconnect.json <<'EOF'
#   {"schema": 1, "enabled": true,
#    "trusted": {"ssids": ["your-home-ssid"], "wired": false}}
#   EOF
#
# Safety: the tool never disconnects, never logs SSIDs, and a missing or
# malformed policy means no action (fail-closed). See tools/autoconnect.py.
set -eu

# NetworkManager passes: $1 interface, $2 action, with CONNECTION_ID,
# DEVICE_TYPE (and for wifi the connection's SSID) in the environment.
# The pre-up.d symlink makes the decision before the interface carries
# traffic; the dispatcher.d copy covers connectivity changes.
exec /opt/advanced-vpn/libexec/avpn-autoconnect "$0" "$@"
