#!/bin/sh
# Refuse to push any commit that is not signed by a key in docs/allowed_signers.
#
# Installed with `git config core.hooksPath tools/hooks`. On 22 Nov 2026 two commits were
# made with signing bypassed (`commit.gpgsign` was set but skipped); nothing then stood
# between them and GitHub. This hook is that stop, for every agent and person pushing
# from this checkout. git passes "<local ref> <local sha> <remote ref> <remote sha>" lines.
set -eu
top=$(git rev-parse --show-toplevel)
signers="$top/docs/allowed_signers"
[ -s "$signers" ] || { echo "pre-push: $signers is missing; refusing" >&2; exit 1; }
zero=0000000000000000000000000000000000000000
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # a deletion carries no commits
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    for line in $(git -c gpg.ssh.allowedSignersFile="$signers" log --format='%H:%G?' $range); do
        case "${line#*:}" in
            G) ;;
            *) echo "pre-push: ${line%%:*} is not signed by an allowed key (${line#*:}); refusing" >&2; bad=1 ;;
        esac
    done
done
exit "$bad"
